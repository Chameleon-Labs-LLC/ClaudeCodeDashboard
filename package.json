{
  "name": "claude-code-dashboard",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:otel": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup:otel": "tsx scripts/setup-otel.ts",
    "daemon": "tsx scripts/daemon.ts",
    "models:refresh": "curl -sf ${MODEL_REGISTRY_URL:-https://chameleonlabs-model-registry.s3.us-east-1.amazonaws.com/models/latest.json} -o lib/model-registry.fallback.json",
    "pricing:refresh": "tsx scripts/refresh-pricing.ts"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5",
    "better-sqlite3": "^11.10.0",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.400.0",
    "next": "^16.4.5",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10",
    "eslint": "^10.2.0",
    "eslint-config-next": "^16.4.1",
    "eventsource": "^2.0.2",
    "postcss": "^8",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "minimatch@10": "11.0.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
